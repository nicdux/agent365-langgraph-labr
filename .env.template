# ---------------------------------------------------------------------------
# Azure OpenAI
# Preencha manualmente com os dados do recurso criado na Etapa 3 do README.
# ---------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://SEU-RECURSO.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# ---------------------------------------------------------------------------
# Observabilidade
# ---------------------------------------------------------------------------
ENABLE_OBSERVABILITY=true
ENABLE_A365_OBSERVABILITY_EXPORTER=true

# Coloque true para ver os spans em JSON no console (util para depurar).
MOSTRAR_SPANS=false

# ---------------------------------------------------------------------------
# Atribuicao no Microsoft Defender
# Sem estes campos o Defender registra que o agente executou, mas nao
# consegue dizer quem pediu. Preencha com os dados do usuario que roda o lab.
#
# A365_AGENT_AUID e A365_AGENT_EMAIL so existem se o agente tiver conta de
# usuario propria (caminho AI Teammate, que exige o programa Frontier).
# Em um Standard Agent, deixe os dois em branco.
# ---------------------------------------------------------------------------
A365_AGENT_AUID=
A365_AGENT_EMAIL=

# Object ID, e-mail e nome do usuario que interage com o agente.
A365_CALLER_USER_ID=
A365_CALLER_USER_EMAIL=
A365_CALLER_USER_NAME=

# ---------------------------------------------------------------------------
# Agent 365
# NAO preencha estas linhas manualmente. O comando abaixo grava todas elas
# neste arquivo automaticamente:
#
#     a365 setup all --agent-name "SeuAgente" --authmode s2s
#
# AGENT365OBSERVABILITY__AGENTNAME
# AGENT365OBSERVABILITY__AGENTID
# AGENT365OBSERVABILITY__AGENTBLUEPRINTID
# AGENT365OBSERVABILITY__TENANTID
# AGENT365OBSERVABILITY__CLIENTID
# AGENT365OBSERVABILITY__CLIENTSECRET
# ---------------------------------------------------------------------------
