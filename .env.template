# ---------------------------------------------------------------------------
# Azure OpenAI
# Preencha manualmente com os dados do recurso criado na Etapa 3 do README.
# ---------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://SEU-RECURSO.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Interface "Pergunte ao Eduardo": auto usa DefaultAzureCredential localmente
# e ManagedIdentityCredential quando EDUARDO_AUTH_MODE=appservice.
# Alternativas explicitas: default, managed_identity, api_key.
AZURE_OPENAI_AUTH_MODE=auto
AZURE_MANAGED_IDENTITY_CLIENT_ID=

# Opcional, apenas com AZURE_OPENAI_AUTH_MODE=api_key. No Azure, use Key Vault.
AZURE_OPENAI_API_KEY=

# O padrao e restrito ao loopback. Nunca exponha este modo na rede.
# No Azure App Service: appservice, Easy Auth com Microsoft Entra obrigatorio,
# e o hostname HTTPS exato em EDUARDO_ALLOWED_HOSTS.
EDUARDO_AUTH_MODE=local
EDUARDO_ALLOWED_HOSTS=localhost,127.0.0.1
# Timeout do fluxo completo: classificar, gerar e validar. Maximo: 60 segundos.
EDUARDO_TIMEOUT_SECONDS=30

# Perfil visual/manual preservado; nao e a base de conhecimento do chat Microsoft.
# Caminho padrao: knowledge/eduardo.json.
EDUARDO_KNOWLEDGE_PATH=

# ---------------------------------------------------------------------------
# Observabilidade
# ---------------------------------------------------------------------------
ENABLE_OBSERVABILITY=true
ENABLE_A365_OBSERVABILITY_EXPORTER=true

# Coloque true para ver os spans em JSON no console (util para depurar).
MOSTRAR_SPANS=false

# ---------------------------------------------------------------------------
# Atribuicao no Microsoft Defender
# Sem estes campos o Defender registra que o agente executou, mas nao
# consegue dizer quem pediu. Preencha com os dados do usuario que roda o lab.
#
# A365_AGENT_AUID e A365_AGENT_EMAIL so existem se o agente tiver conta de
# usuario propria (caminho AI Teammate, que exige o programa Frontier).
# Em um Standard Agent, deixe os dois em branco.
# ---------------------------------------------------------------------------
A365_AGENT_AUID=
A365_AGENT_EMAIL=

# Object ID, e-mail e nome do usuario que interage com o agente.
A365_CALLER_USER_ID=
A365_CALLER_USER_EMAIL=
A365_CALLER_USER_NAME=

# ---------------------------------------------------------------------------
# Agent 365
# NAO preencha estas linhas manualmente. O comando abaixo grava todas elas
# neste arquivo automaticamente:
#
#     a365 setup all --agent-name "SeuAgente" --authmode s2s
#
# AGENT365OBSERVABILITY__AGENTNAME
# AGENT365OBSERVABILITY__AGENTID
# AGENT365OBSERVABILITY__AGENTBLUEPRINTID
# AGENT365OBSERVABILITY__TENANTID
# AGENT365OBSERVABILITY__CLIENTID
# AGENT365OBSERVABILITY__CLIENTSECRET
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Microsoft Purview - OPCIONAL
#
# Preencha esta secao APENAS se quiser que o agente BLOQUEIE prompts e
# respostas em tempo real com base numa politica de DLP. Sem ela o agente
# funciona normalmente: PURVIEW_ENABLED tem false como padrao e as chamadas
# ao Purview nunca acontecem.
#
# O app cliente do Purview NAO e criado pelo 'a365 setup all'. E um registro
# separado no Entra, que voce cria a mao. Veja a secao "Purview SDK - o app
# cliente" no README.
#
# ATENCAO: o segredo precisa ficar em PURVIEW_CLIENT_SECRET. Se voce usar o
# nome AZURE_CLIENT_SECRET, o DefaultAzureCredential adota este app para tudo,
# inclusive o Azure OpenAI, e o modelo passa a responder 401 PermissionDenied
# sem nenhuma pista da causa real.
# ---------------------------------------------------------------------------
PURVIEW_ENABLED=false

# Application (client) ID e segredo do app cliente do Purview.
PURVIEW_CLIENT_APP_ID=
PURVIEW_CLIENT_SECRET=

# Object ID do usuario em nome de quem o agente avalia o conteudo.
# Se ficar em branco, o agente usa o A365_CALLER_USER_ID acima.
PURVIEW_USER_ID=

# O que fazer quando a CHAMADA ao Purview falha (timeout, token, HTTP 400):
#   true  -> o agente recusa a requisicao (use em producao)
#   false -> o agente responde normalmente, sem avaliacao de politica
#
# Em producao use true: com false, qualquer erro na API vira bypass de
# politica. No teste de bloqueio, porem, false e o que da valor a evidencia --
# se o agente bloqueou mesmo assim, o bloqueio veio da politica.
PURVIEW_FAIL_CLOSED=true
